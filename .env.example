# Divine Insight — Web environment
#
# Copy to `.env` (gitignored) and fill in what you need. None of these are
# required to build or run the dev server.

# Vercel deploy token — required only by `bun run go-live` (go-live.sh).
# Collected from the project owner; personal tokens have no team scope.
VERCEL_TOKEN=

# Optional go-live overrides. Usually auto-resolved from VERCEL_TOKEN.
# VERCEL_SCOPE=your-team-slug
# VERCEL_TEAM_ID=team_xxx
# VERCEL_PROJECT_NAME=divine-insight-web

# Neon Postgres connection string — used only by src/db.ts (server-only).
# Resolved lazily per call, so the site builds and serves without it; the
# error surfaces only if a query actually runs.
DATABASE_URL=

# Stripe webhook signing secret (whsec_...) from the Stripe Dashboard.
# Required for /api/stripe-webhook to accept events and mark orders paid.
# go-live.sh fails fast if this is missing.
STRIPE_WEBHOOK_SECRET=

# Gift email delivery via Resend.
# Required to send Gift Reading claim emails.
# go-live.sh fails fast if either of these is missing.
RESEND_API_KEY=
GIFT_FROM_EMAIL=

# Optional canonical site origin for gift claim links.
# Falls back to the request origin when unset.
PUBLIC_SITE_URL=

# Canonical origin for og:url / og:image / <link rel="canonical"> tags in
# src/routes/__root.tsx. Set this to the real production domain at deploy
# time. Falls back to VERCEL_PROJECT_PRODUCTION_URL on Vercel, then to a
# relative path (never a hardcoded sandbox/preview domain).
SITE_URL=
